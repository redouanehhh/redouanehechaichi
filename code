<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Histoire de l’Algérie — site de démo</title>
<meta name="description" content="Une chronologie interactive de l’histoire de l’Algérie, de la préhistoire à nos jours.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,800&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F2F5F3; --panel:#E6ECE9; --ink:#14272B; --muted:#4A5F63; --line:#C5D2CF;
  --mer:#0E4B5A; --vert:#006233; --rouge:#C8102E; --star:#0E4B5A;
  --e-antiquite:#B9812F; --e-moyen:#1F7A6B; --e-regence:#2B5F9E; --e-colonie:#C8102E; --e-indep:#006233; --e-contemp:#6B4E9B;
  --serif:"Fraunces",Georgia,"Times New Roman",serif;
  --sans:"Public Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
@media (prefers-color-scheme:dark){
  :root{--bg:#0C1B1F; --panel:#13282D; --ink:#E7EFED; --muted:#A3B8B7; --line:#26403F; --mer:#7CC4D1; --star:#7CC4D1}
}
*{box-sizing:border-box}
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:calc(4.5rem + env(safe-area-inset-top,0px))}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
html{scroll-behavior:smooth;scroll-padding-top:4.5rem}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 var(--sans)}
a{color:inherit}
:focus-visible{outline:3px solid var(--e-regence);outline-offset:3px;border-radius:4px}

header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
header.top div{max-width:68rem;margin:auto;padding:.85rem 1.25rem;display:flex;justify-content:space-between;align-items:center;gap:1rem}
header.top strong{font:600 1.05rem var(--serif)}
header.top nav{display:flex;gap:1.25rem;font-size:.95rem}
header.top nav a{text-decoration:none;color:var(--muted)}
header.top nav a:hover{color:var(--ink)}

.hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line)}
.hero svg.pattern{position:absolute;inset:0;width:100%;height:100%;color:var(--star);opacity:.13;pointer-events:none}
.hero .in{position:relative;max-width:68rem;margin:auto;padding:clamp(4rem,12vw,9rem) 1.25rem clamp(3.5rem,9vw,6.5rem)}
.hero .ar{font:700 clamp(4.5rem,18vw,12rem)/1 "Amiri",var(--serif);color:var(--vert);margin:0;direction:rtl;text-align:left}
.hero h1{font:800 clamp(2.2rem,6.5vw,4.6rem)/1.05 var(--serif);letter-spacing:-.02em;margin:.4rem 0 1.25rem;max-width:16ch}
.hero p{max-width:40rem;color:var(--muted);font-size:1.15rem;margin:0 0 2rem}
.btn{display:inline-block;background:var(--vert);color:#fff;text-decoration:none;font-weight:600;padding:.8rem 1.4rem;border-radius:999px}
.btn:hover{filter:brightness(1.12)}
.flagbar{display:flex;height:6px}
.flagbar i{flex:1}.flagbar i:nth-child(1){background:var(--vert)}.flagbar i:nth-child(2){background:#fff}.flagbar i:nth-child(3){background:var(--rouge)}
@media (prefers-reduced-motion:no-preference){
  .hero .in>*{animation:rise .9s cubic-bezier(.2,.7,.2,1) both}
  .hero .in>*:nth-child(2){animation-delay:.12s}.hero .in>*:nth-child(3){animation-delay:.22s}.hero .in>*:nth-child(4){animation-delay:.32s}
  @keyframes rise{from{opacity:0;transform:translateY(18px)}}
}

main{max-width:68rem;margin:auto;padding:0 1.25rem}
section{padding:clamp(3rem,7vw,5.5rem) 0}
h2{font:600 clamp(1.8rem,4vw,2.6rem)/1.15 var(--serif);margin:0 0 .6rem;letter-spacing:-.01em}
.lead{color:var(--muted);max-width:42rem;margin:0 0 2rem}

.filters{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:2.5rem}
.filters button{font:500 .95rem var(--sans);color:var(--ink);background:transparent;border:1.5px solid var(--line);border-radius:999px;padding:.45rem 1rem;cursor:pointer;display:inline-flex;align-items:center;gap:.5rem}
.filters button::before{content:"";width:.65rem;height:.65rem;border-radius:50%;background:var(--c,var(--muted))}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}

ol.timeline{list-style:none;margin:0;padding:0;position:relative}
ol.timeline::before{content:"";position:absolute;left:10.5rem;top:.4rem;bottom:.4rem;width:2px;background:var(--line)}
.ev{display:grid;grid-template-columns:10rem 1fr;column-gap:2rem;position:relative;padding:0 0 2.4rem}
.ev[hidden]{display:none}
.ev time{font:600 1.15rem/1.3 var(--serif);text-align:right;padding-top:.05rem}
.ev .body{position:relative}
.ev .body::before{content:"";position:absolute;left:calc(-1rem - 7px);top:.45rem;width:14px;height:14px;border-radius:50%;background:var(--c);box-shadow:0 0 0 4px var(--bg)}
.ev h3{font:600 1.25rem/1.3 var(--serif);margin:0 0 .35rem}
.ev p{margin:0;color:var(--muted);max-width:38rem}
.ev small{display:block;margin-top:.5rem;font-size:.85rem;color:var(--c);font-weight:600;filter:brightness(var(--tint,1))}
@media (prefers-color-scheme:dark){.ev small{--tint:1.35}}
@media (max-width:640px){
  ol.timeline::before{left:7px}
  .ev{grid-template-columns:1fr;padding-left:2rem}
  .ev time{text-align:left;margin-bottom:.2rem}
  .ev .body::before{left:calc(-2rem + 1px);top:-1.55rem}
  .ev time{position:relative}
}

.figures{background:var(--panel);margin:0 calc(50% - 50vw);padding-left:calc(50vw - 50%);padding-right:calc(50vw - 50%)}
.fig-list{list-style:none;margin:2rem 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:2rem 2.5rem}
.fig-list li{border-top:3px solid var(--c);padding-top:.9rem}
.fig-list b{display:block;font:600 1.25rem var(--serif)}
.fig-list span{display:block;font-size:.9rem;color:var(--muted);margin:.1rem 0 .5rem}
.fig-list p{margin:0}

footer{border-top:1px solid var(--line);padding:2.5rem 1.25rem 3rem;text-align:center;color:var(--muted);font-size:.92rem}
footer p{max-width:40rem;margin:.3rem auto}
</style>
</head>
<body>

<header class="top">
  <div>
    <strong>Histoire de l’Algérie</strong>
    <nav aria-label="Navigation principale">
      <a href="#chronologie">Chronologie</a>
      <a href="#figures">Figures</a>
      <a href="#a-propos">À propos</a>
    </nav>
  </div>
</header>

<div class="hero">
  <svg class="pattern" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="khatam" width="96" height="96" patternUnits="userSpaceOnUse">
        <g fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="24" y="24" width="48" height="48"/>
          <rect x="24" y="24" width="48" height="48" transform="rotate(45 48 48)"/>
          <circle cx="48" cy="48" r="9"/>
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#khatam)"/>
  </svg>
  <div class="in">
    <p class="ar" lang="ar" dir="rtl">الجزائر</p>
    <h1>De la Numidie à l’Algérie d’aujourd’hui</h1>
    <p>Une chronologie pour parcourir l’histoire d’un pays tourné vers la Méditerranée et le Sahara : royaumes numides, dynasties du Maghreb, Régence d’Alger, colonisation, guerre d’indépendance.</p>
    <a class="btn" href="#chronologie">Explorer la chronologie</a>
  </div>
</div>
<div class="flagbar" aria-hidden="true"><i></i><i></i><i></i></div>

<main>
  <section id="chronologie">
    <h2>Chronologie</h2>
    <p class="lead">Filtrez par période pour suivre un fil à la fois.</p>
    <div class="filters" role="group" aria-label="Filtrer par période" id="filters"></div>
    <ol class="timeline" id="timeline"></ol>
  </section>
</main>

<section id="figures" class="figures">
  <div style="max-width:68rem;margin:auto">
    <h2>Figures marquantes</h2>
    <p class="lead">Quelques noms qui reviennent dans les récits de chaque époque.</p>
    <ul class="fig-list">
      <li style="--c:var(--e-antiquite)"><b>Massinissa</b><span>v. 238 – 148 av. J.-C.</span><p>Roi numide, il bâtit un royaume puissant après avoir rejoint Rome à la bataille de Zama.</p></li>
      <li style="--c:var(--e-antiquite)"><b>Saint Augustin</b><span>354 – 430</span><p>Né à Thagaste, évêque d’Hippone, l’un des penseurs majeurs de l’Antiquité tardive.</p></li>
      <li style="--c:var(--e-colonie)"><b>Émir Abdelkader</b><span>1808 – 1883</span><p>Chef de la résistance à la conquête française entre 1832 et 1847, puis penseur et homme d’État.</p></li>
      <li style="--c:var(--e-colonie)"><b>Abdelhamid Ben Badis</b><span>1889 – 1940</span><p>Réformateur, fondateur de l’Association des oulémas musulmans algériens en 1931.</p></li>
      <li style="--c:var(--e-indep)"><b>Larbi Ben M’hidi</b><span>1923 – 1957</span><p>Dirigeant du FLN, figure de la guerre d’indépendance et de la bataille d’Alger.</p></li>
    </ul>
  </div>
</section>

<main>
  <section id="a-propos">
    <h2>À propos de ce projet</h2>
    <p class="lead">Ce site est une démo : une page statique, sans dépendance, qui peut devenir la base d’un projet plus complet (cartes, sources, articles par période, versions arabe et tamazight).</p>
  </section>
</main>

<footer>
  <p>Contenu de démonstration, à relire et à sourcer avant toute publication.</p>
  <p>Hébergeable tel quel sur GitHub Pages.</p>
</footer>

<script>
// Pour ajouter un événement, ajoutez simplement un objet dans EVENTS.
const ERAS = {
  antiquite:{label:"Antiquité",color:"var(--e-antiquite)"},
  moyen:{label:"Moyen Âge",color:"var(--e-moyen)"},
  regence:{label:"Régence d’Alger",color:"var(--e-regence)"},
  colonie:{label:"Colonisation",color:"var(--e-colonie)"},
  indep:{label:"Indépendance",color:"var(--e-indep)"},
  contemp:{label:"Époque contemporaine",color:"var(--e-contemp)"}
};
const EVENTS = [
  {era:"antiquite",date:"Préhistoire",title:"Les peintures du Tassili n’Ajjer",text:"Au cœur du Sahara, des milliers de peintures et de gravures rupestres racontent des millénaires de vie, de chasse et de pastoralisme."},
  {era:"antiquite",date:"202 av. J.-C.",title:"Massinissa et la Numidie",text:"Après la bataille de Zama, le roi Massinissa unifie une grande partie des territoires numides, alliés de Rome contre Carthage."},
  {era:"antiquite",date:"100 apr. J.-C.",title:"Timgad, ville romaine",text:"L’empereur Trajan fonde Thamugadi, aujourd’hui Timgad, dont le plan en damier est l’un des mieux conservés de l’Empire."},
  {era:"antiquite",date:"430",title:"Mort de saint Augustin à Hippone",text:"L’évêque d’Hippone (près d’Annaba) meurt pendant le siège de la ville par les Vandales."},
  {era:"moyen",date:"VIIe – VIIIe siècles",title:"L’entrée dans le monde musulman",text:"Le Maghreb central s’intègre progressivement au monde musulman. L’arabe s’installe aux côtés des langues berbères."},
  {era:"moyen",date:"776",title:"Tahert, capitale rustumide",text:"Les Rustumides fondent Tahert, près de l’actuelle Tiaret, un foyer politique et intellectuel du Maghreb."},
  {era:"moyen",date:"1007",title:"La Kalâa des Béni Hammad",text:"Les Hammadides bâtissent une capitale fortifiée dans les montagnes. Béjaïa prend ensuite le relais comme grand port et centre savant."},
  {era:"moyen",date:"1236",title:"Tlemcen, capitale zayyanide",text:"Sous les Zayyanides, Tlemcen devient un carrefour commercial, artistique et religieux entre l’Afrique et l’Europe."},
  {era:"regence",date:"1516 – 1519",title:"Les frères Barberousse à Alger",text:"Arudj puis Khayr ad-Din s’établissent à Alger, qui passe sous la souveraineté ottomane. La Régence d’Alger commence."},
  {era:"colonie",date:"5 juillet 1830",title:"La prise d’Alger",text:"Après le débarquement français de juin, Alger capitule. La conquête du reste du pays durera des décennies."},
  {era:"colonie",date:"1832 – 1847",title:"La résistance de l’émir Abdelkader",text:"Abdelkader organise un État et une armée pour s’opposer aux troupes françaises, jusqu’à sa reddition en décembre 1847."},
  {era:"colonie",date:"1848",title:"Les départements français d’Algérie",text:"Les territoires du nord sont déclarés partie intégrante de la France, tandis que la majorité de la population reste privée de droits politiques égaux."},
  {era:"colonie",date:"8 mai 1945",title:"Sétif, Guelma et Kherrata",text:"Des manifestations pour la fin de la guerre et pour les droits des Algériens sont suivies d’une répression meurtrière dont le bilan reste débattu."},
  {era:"indep",date:"1er novembre 1954",title:"Le début de l’insurrection",text:"Le Front de libération nationale (FLN) lance une série d’attaques dans tout le pays et appelle à l’indépendance."},
  {era:"indep",date:"1957",title:"La bataille d’Alger",text:"Attentats, grèves et opérations de répression dans la capitale marquent l’un des épisodes les plus connus de la guerre."},
  {era:"indep",date:"18 mars 1962",title:"Les accords d’Évian",text:"Le cessez-le-feu est signé, ouvrant la voie à un référendum d’autodétermination."},
  {era:"indep",date:"5 juillet 1962",title:"L’indépendance",text:"Après le référendum du 1er juillet, l’indépendance de l’Algérie est proclamée. Alger célèbre la fin de 132 ans de domination coloniale."},
  {era:"contemp",date:"1963",title:"Ahmed Ben Bella, premier président",text:"Le pays se dote d’une première Constitution et choisit un régime de parti unique."},
  {era:"contemp",date:"1971",title:"Nationalisation des hydrocarbures",text:"L’État prend le contrôle du pétrole et du gaz, devenus le moteur de l’économie."},
  {era:"contemp",date:"1988 – 1989",title:"Octobre 1988 et le multipartisme",text:"Des émeutes secouent le pays. Une nouvelle Constitution adoptée en 1989 ouvre la voie au pluralisme politique."},
  {era:"contemp",date:"Années 1990",title:"Une décennie de violences",text:"Un conflit interne meurtrier oppose l’État à des groupes armés. Il laisse des blessures profondes dans la société."},
  {era:"contemp",date:"22 février 2019",title:"Le Hirak",text:"Un mouvement populaire de masse, pacifique, réclame un changement politique. Le président Bouteflika démissionne en avril."}
];

const filters = document.getElementById("filters");
const list = document.getElementById("timeline");

function el(tag, props = {}, ...kids){
  const n = Object.assign(document.createElement(tag), props);
  kids.forEach(k => n.append(k));
  return n;
}

EVENTS.forEach(e => {
  const era = ERAS[e.era];
  const li = el("li", {className:"ev"});
  li.dataset.era = e.era;
  li.style.setProperty("--c", era.color);
  li.append(
    el("time", {textContent:e.date}),
    el("div", {className:"body"},
      el("h3", {textContent:e.title}),
      el("p", {textContent:e.text}),
      el("small", {textContent:era.label})
    )
  );
  list.append(li);
});

let active = "all";
function render(){
  list.querySelectorAll(".ev").forEach(li => { li.hidden = active !== "all" && li.dataset.era !== active; });
  filters.querySelectorAll("button").forEach(b => b.setAttribute("aria-pressed", b.dataset.era === active));
}
[["all","Toutes les périodes",null], ...Object.entries(ERAS).map(([k,v]) => [k,v.label,v.color])].forEach(([key,label,color]) => {
  const b = el("button", {type:"button", textContent:label});
  b.dataset.era = key;
  if(color) b.style.setProperty("--c", color);
  b.addEventListener("click", () => { active = key; render(); });
  filters.append(b);
});
render();
</script>
</body>
</html>
